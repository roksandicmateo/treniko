# Dependencies
node_modules/
# package-lock.json is deliberately NOT ignored (Security Hardening Phase 3).
# Without a committed lockfile every install re-resolves the whole dependency
# tree from semver ranges, so no two installs are guaranteed to be the same
# tree, a compromised new release of any transitive package is picked up
# silently, and audit results cannot be reproduced. `npm ci` — which CI uses
# precisely because it installs exactly what was reviewed — cannot run at all
# without it.
yarn.lock

# Environment variables
.env
backend/.env
frontend/.env

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build
dist/
build/
# The SSR bundle for the homepage prerender. Intermediate build output: it is
# produced by `npm run build` (vite build --ssr), consumed by
# scripts/prerender.mjs, and never served. See src/entry-prerender.jsx.
dist-ssr/

# Claude Code — personal, machine-local overrides (permission mode etc.)
.claude/settings.local.json

# Rendered social assets — the slide PNGs, story frames and Reel MP4s under
# marketing/social/30-day/. Around 18 MB, and all of it is output: the scripts
# in _tooling/ regenerate every frame from the copy in the calendar markdown,
# which is what actually needs reviewing and versioning. Committing the renders
# would put 18 MB of derived binaries into the history permanently, and they
# would be re-committed on every tweak to a font size.
#
# The brand assets in marketing/brand/ are NOT ignored: those are source of a
# different kind — a logo is not regenerated from anything.
marketing/social/30-day/posts/
marketing/social/30-day/stories/
marketing/social/30-day/reels/
marketing/social/30-day/facebook/
marketing/social/30-day/highlights/
