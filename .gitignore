# Dependencies
node_modules/
# package-lock.json is deliberately NOT ignored (Security Hardening Phase 3).
# Without a committed lockfile every install re-resolves the whole dependency
# tree from semver ranges, so no two installs are guaranteed to be the same
# tree, a compromised new release of any transitive package is picked up
# silently, and audit results cannot be reproduced. `npm ci` — which CI uses
# precisely because it installs exactly what was reviewed — cannot run at all
# without it.
yarn.lock

# Environment variables
.env
backend/.env
frontend/.env

# Logs
*.log
npm-debug.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Build
dist/
build/
# The SSR bundle for the homepage prerender. Intermediate build output: it is
# produced by `npm run build` (vite build --ssr), consumed by
# scripts/prerender.mjs, and never served. See src/entry-prerender.jsx.
dist-ssr/

# Claude Code — personal, machine-local overrides (permission mode etc.)
.claude/settings.local.json
