{
  "name": "treniko-backend",
  "version": "1.0.0",
  "description": "TRENIKO Backend API - Multi-tenant training management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "init-db": "node scripts/initDatabase.js"
  },
  "keywords": [
    "training",
    "management",
    "multi-tenant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "archiver": "^5.3.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "express-validator": "^7.0.1",
    "helmet": "^8.1.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^3.0.3",
    "nodemailer": "^8.0.4",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/*",
      "uploads/**/*",
      "logs/*",
      "*.log"
    ],
    "watch": [
      "."
    ],
    "ext": "js,json"
  }
}
