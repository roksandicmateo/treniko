{
  "name": "treniko-backend",
  "version": "1.0.0",
  "description": "TRENIKO Backend API - Multi-tenant training management system",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "db:migrate": "node scripts/migrate.js",
    "db:status": "node scripts/migrate.js status",
    "db:baseline": "node scripts/migrate.js baseline",
    "init-db": "node scripts/migrate.js",
    "test": "jest --runInBand --forceExit",
    "test:security": "jest tests/security --runInBand --forceExit"
  },
  "jest": {
    "testEnvironment": "node",
    "testMatch": [
      "**/tests/**/*.test.js"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "training",
    "management",
    "multi-tenant"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "archiver": "^5.3.2",
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^6.11.2",
    "helmet": "^8.1.0",
    "json2csv": "^5.0.7",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "node-cron": "^4.6.0",
    "pg": "^8.11.3"
  },
  "devDependencies": {
    "jest": "^30.4.2",
    "nodemon": "^3.0.2",
    "supertest": "^7.2.2"
  },
  "nodemonConfig": {
    "ignore": [
      "uploads/*",
      "uploads/**/*",
      "logs/*",
      "*.log"
    ],
    "watch": [
      "."
    ],
    "ext": "js,json"
  }
}
