# Dependencies
node_modules/
# package-lock.json is deliberately NOT ignored (Security Hardening Phase 3).
# Without a committed lockfile every install re-resolves the whole dependency
# tree from semver ranges, so no two installs are guaranteed to be the same
# tree, a compromised new release of any transitive package is picked up
# silently, and audit results cannot be reproduced. `npm ci` — which CI uses
# precisely because it installs exactly what was reviewed — cannot run at all
# without it.
yarn.lock

# Environment variables
.env
.env.local
.env.production

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# Uploaded client files (TR-LOW-9).
# These are private client photos written at runtime. The directory is created
# by the application and by the upload tests; nothing in it belongs in version
# control, and committing one would publish a client's personal data.
uploads/

# Testing
coverage/
.nyc_output/

# Build
dist/
build/
